<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the RunnitWidgets extension so the Home/Lock Screen widget can
	     read the trip snapshot this app writes (Services/WidgetSnapshotWriter). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.Runnit.Runnit-iOS</string>
	</array>
</dict>
</plist>
