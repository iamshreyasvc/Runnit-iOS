<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the app's secrets. To enable live flight tracking:

    1. Copy this file to "Runnit iOS/Secrets.plist"
         cp Secrets.example.plist "Runnit iOS/Secrets.plist"
    2. Replace PASTE_YOUR_KEY_HERE below with your AviationStack API key
       (https://aviationstack.com/dashboard -> "API Access Key").
    3. Build & run.

  "Runnit iOS/Secrets.plist" is gitignored, so your real key is never committed.
  Without a key the app runs normally — live flight tracking is simply off.
-->
<plist version="1.0">
<dict>
	<key>AviationStackAPIKey</key>
	<string>PASTE_YOUR_KEY_HERE</string>
</dict>
</plist>
