<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the app's secrets. To enable live flight tracking:

    1. Copy this file to "Runnit iOS/Secrets.plist"
         cp Secrets.example.plist "Runnit iOS/Secrets.plist"
    2. Replace PASTE_YOUR_KEY_HERE below with your Flightradar24 API token
       (https://fr24api.flightradar24.com -> Key management -> "Create token").
       The token is shown once — copy it before closing the dialog.
    3. Build & run.

  "Runnit iOS/Secrets.plist" is gitignored, so your real token is never committed.
  Without a token the app runs normally — live flight tracking is simply off.

  AviationStackAPIKey is no longer read by the app; live tracking moved to
  Flightradar24. It's listed here only so the retained AviationStack client has a
  documented home if it's ever revived.
-->
<plist version="1.0">
<dict>
	<key>FlightRadarAPIToken</key>
	<string>PASTE_YOUR_KEY_HERE</string>
</dict>
</plist>
