<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  This file used to carry an App Transport Security exception for
	  api.aviationstack.com, whose free tier was HTTP-only. Live tracking now runs
	  on Flightradar24 over HTTPS, so the app needs no ATS exceptions at all and
	  runs under the default policy.

	  GENERATE_INFOPLIST_FILE is still YES; Xcode merges the generated keys (scene
	  manifest, launch screen, orientations, location usage string, etc.) on top of
	  this file at build time — this file only adds what can't be expressed as a
	  flat INFOPLIST_KEY_* build setting.
	-->

	<!-- Lets the app run Live Activities for trips that are under way. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!--
	  CloudKit sharing. `CKSharingSupported` is what lets an invite link opened
	  in Messages or Mail hand off to this app; the remote-notification
	  background mode lets CloudKit's silent pushes wake the sync engines when a
	  shared trip changes on someone else's device. Neither has an
	  INFOPLIST_KEY_* equivalent, so they live here.
	-->
	<!--
	  Master switch for CloudKit, read by `CloudContainer.isEnabled`.

	  Off because iCloud is unavailable to free Apple developer accounts, and
	  merely constructing a CKContainer without the entitlement crashes the app.
	  Turn on together with the iCloud → CloudKit capability in Xcode.
	-->
	<key>RunnitCloudKitEnabled</key>
	<false/>
	<key>CKSharingSupported</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
